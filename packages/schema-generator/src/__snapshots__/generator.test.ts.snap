  return undefined;
}

// =============================================================================
// Query Helpers (クエリヘルパー)
// =============================================================================

// フィールドタイプ別の型定義
export type CustomersTextField = "name" | "quoted" | "pathish" | "templated" | "顧客名";
export type CustomersMultiLineTextField = "memo";
export type CustomersNumberField = "weird-code";
export type CustomersSelectField = "status" | "radio" | "checks";

/**
 * 全検索可能フィールド
 */
export type CustomersSearchableField = "name" | "memo" | "quoted" | "pathish" | "templated" | "status" | "radio" | "checks" | "顧客名" | "weird-code" | '$id' | '$revision';

/**
 * クエリビルダーのヘルパー関数
 */
export const CustomersQuery = {
  eq: (field: CustomersTextField | CustomersNumberField | never | never | '$id' | '$revision', value: string | number) =>
    \`\${field} = "\${value}"\`,

  ne: (field: CustomersTextField | CustomersNumberField | never | never | '$id' | '$revision', value: string | number) =>
    \`\${field} != "\${value}"\`,

  in: (field: CustomersTextField | CustomersNumberField | CustomersSelectField | never | never | '$id' | '$revision', values: (string | number)[]) =>
    \`\${field} in (\${values.map((v) => \`"\${v}"\`).join(', ')})\`,

  notIn: (field: CustomersTextField | CustomersNumberField | CustomersSelectField | never | never | '$id' | '$revision', values: (string | number)[]) =>
    \`\${field} not in (\${values.map((v) => \`"\${v}"\`).join(', ')})\`,

  like: (field: CustomersTextField | CustomersMultiLineTextField, value: string) =>
    \`\${field} like "\${value}"\`,

  notLike: (field: CustomersTextField | CustomersMultiLineTextField, value: string) =>
    \`\${field} not like "\${value}"\`,

  gt: (field: CustomersNumberField | never | '$id' | '$revision', value: string | number) =>
    \`\${field} > "\${value}"\`,

  gte: (field: CustomersNumberField | never | '$id' | '$revision', value: string | number) =>
    \`\${field} >= "\${value}"\`,

  lt: (field: CustomersNumberField | never | '$id' | '$revision', value: string | number) =>
    \`\${field} < "\${value}"\`,

  lte: (field: CustomersNumberField | never | '$id' | '$revision', value: string | number) =>
    \`\${field} <= "\${value}"\`,

  and: (...conditions: string[]) =>
    conditions.filter(Boolean).join(' and '),

  or: (...conditions: string[]) =>
    \`(\${conditions.filter(Boolean).join(' or ')})\`,

  orderBy: (field: CustomersSearchableField, direction: 'asc' | 'desc' = 'asc') =>
    \`order by \${field} \${direction}\`,

  limit: (count: number) =>
    \`limit \${count}\`,

  offset: (count: number) =>
    \`offset \${count}\`,
} as const;
"
`;
