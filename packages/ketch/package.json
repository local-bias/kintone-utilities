{
  "name": "@konomi-app/ketch",
  "version": "1.0.0",
  "description": "kintone.proxy, kintone.plugin.proxy wrapper for Fetch API",
  "keywords": [
    "kintone",
    "proxy",
    "fetch",
    "plugin",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "repository": "https://github.com/local-bias/kintone-utilities.git",
  "homepage": "https://github.com/local-bias/kintone-utilities#readme",
  "bugs": {
    "url": "https://github.com/local-bias/kintone-utilities/issues"
  },
  "author": "adachi keiichiro",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "pnpm build && pnpm test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
