{
  "name": "@konomi-app/kintone-utilities",
  "version": "6.3.0",
  "description": "kintone カスタマイズ・プラグイン開発のためのユーティリティ関数集",
  "keywords": [
    "kintone",
    "rest-api",
    "plugin",
    "utilities",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "require": {
        "types": "./dist/*.d.cts",
        "default": "./dist/*.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "repository": "https://github.com/local-bias/kintone-utilities.git",
  "homepage": "https://github.com/local-bias/kintone-utilities#readme",
  "bugs": {
    "url": "https://github.com/local-bias/kintone-utilities/issues"
  },
  "author": "Ribbit",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build && pnpm test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@kintone/dts-gen": "^9.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
